---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand, languages, type Lang } from '../config';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  nav?: { href: string; label: string }[];
  // Equivalent page in each language, for the language switcher and hreflang.
  alternates?: Partial<Record<Lang, string>>;
}

const { lang, title, description, nav = [], alternates = {} } = Astro.props;
const alt = Object.fromEntries(
  (Object.keys(languages) as Lang[]).map((l) => [l, alternates[l] ?? languages[l].home]),
) as Record<Lang, string>;
const htmlLang = { pt: 'pt-BR', en: 'en', es: 'es' }[lang];
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {brand.name}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {(Object.keys(alt) as Lang[]).map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(alt[l], Astro.site)} />
    ))}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header lang={lang} nav={nav} alternates={alt} />
    <main><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
