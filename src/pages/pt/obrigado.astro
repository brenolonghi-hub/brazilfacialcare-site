<Base lang="pt" title="Recebemos seu pré-cadastro" description="Recebemos seu pré-cadastro" alternates={{ pt: '/pt/obrigado/', en: '/en/thank-you/', es: '/es/gracias/' }}>
  <section class="hero">
    <div class="wrap prose">
      <h1>Recebemos seu pré-cadastro</h1>
      <p class="lead">Obrigado pelo interesse. Vamos analisar seus dados e entrar em contato por e-mail ou WhatsApp nos próximos dias.</p>
      <a class="btn ghost" href="/pt/">Voltar ao início</a>
    </div>
  </section>
</Base>
