{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brazilfacialcare",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brazilfacialcare",
      "database_id": "2deb2062-b4d3-40a5-befe-5eedb9590dc3",
      "migrations_dir": "migrations"
    }
  ],
  // Notification email. The destination must be verified in Email Routing.
  "send_email": [{ "name": "NOTIFY" }],
  "vars": {
    "NOTIFY_FROM": "site@brazilfacialcare.com",
    "NOTIFY_TO": "contato@fidelco.com.br"
  }
}
